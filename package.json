{
    "name": "carbon-monorepo",
    "version": "0.1.0",
    "description": "Monorepo for Carbon code generation and command-line utilities.",
    "private": true,
    "workspaces": [
        "packages/*"
    ],
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "turbo run lint",
        "test": "turbo run test",
        "clean": "turbo run clean && rm -rf node_modules .turbo",
        "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
        "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json}\" \"*.{ts,tsx,js,jsx,json,md}\"",
        "type-check": "turbo run type-check",
        "carbon-gen:prep": "pnpm --filter @sevenlabs-hq/carbon-versions build && pnpm --filter @sevenlabs-hq/carbon-codama-renderer build && pnpm --filter @sevenlabs-hq/carbon-cli build",
        "carbon-gen:pump-bc": "node ./packages/cli/dist/cli.js parse --idl 6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P -u mainnet-beta --out-dir ./decoders/pumpfun-decoder/ -s anchor",
        "carbon-gen:pump-fees": "node ./packages/cli/dist/cli.js parse --idl pfeeUxB6jkeY1Hxd7CsFCAjcbHA9rWtchMGdZ6VojVZ -u mainnet-beta --out-dir ./decoders/pump-fees-decoder/ -s anchor",
        "carbon-gen:pump-amm": "node ./packages/cli/dist/cli.js parse --idl ./idls/pump_amm.json --out-dir ./decoders/pump-swap-decoder/ -s anchor",
        "carbon-gen:all": "pnpm run carbon-gen:prep && pnpm run carbon-gen:pump-bc && pnpm run carbon-gen:pump-fees && pnpm run carbon-gen:pump-amm"
    },
    "devDependencies": {
        "@types/node": "^24.0.10",
        "prettier": "^3.6.2",
        "rimraf": "^6.0.1",
        "turbo": "^2.5.4",
        "typescript": "^5.8.3"
    },
    "packageManager": "pnpm@9.6.0",
    "engines": {
        "node": ">=18.0.0",
        "pnpm": ">=8.0.0"
    },
    "pnpm": {
        "overrides": {
            "@codama/nodes": "1.3.0",
            "@codama/visitors-core": "1.3.0",
            "@codama/renderers-core": "1.0.16",
            "@codama/errors": "1.3.0"
        }
    }
}
